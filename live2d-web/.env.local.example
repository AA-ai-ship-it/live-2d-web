# ========================
# 本地开发环境变量配置模板
# 复制本文件为 .env.local 并填入实际值：
#   cp .env.local.example .env.local
# ========================

# 后端 API 地址
# 开发：AutoDL GPU 实例外网地址（部署后填入）
# 生产：ICP备案域名（如 https://api.live2d-web.com）
# 留空时 fallback 到同源（适合前后端同域部署场景）
NEXT_PUBLIC_API_BASE=https://your-autodl-gpu-instance.example.com

# 可选：请求超时时间（毫秒）
# 不设置时默认 30000（30 秒），上传超时另在 request.ts 内单独设为 5 分钟
# NEXT_PUBLIC_REQUEST_TIMEOUT=30000
