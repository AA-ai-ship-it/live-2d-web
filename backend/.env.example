# ========================
# 后端环境变量配置模板
# ========================
# 复制本文件为 .env 并填入实际值
# cp .env.example .env

# ====== see-through-main 路径 ======
# see-through-main 开源项目所在目录
SEETHROUGH_PATH=/root/autodl-tmp/see-through/see-through-main

# ====== Python 环境 ======
# conda 环境名（RunPod 上用 conda 或 venv）
# PYTHONPATH 需包含 see-through-main 根目录和 common 子目录

# ====== 模型下载（HuggingFace 镜像）======
# 海外版不需要镜像，直接用默认地址
# HF_ENDPOINT=https://hf-mirror.com  # 国内用，海外注释掉

# ====== GPU 内存优化 ======
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ====== 推理默认参数 ======
SEETHROUGH_RESOLUTION=768
SEETHROUGH_STEPS=20
SEETHROUGH_GROUP_OFFLOAD=0

# ====== NSFW 检测（AWS Rekognition）======
# 海外版必需：Stripe 对允许 NSFW 内容的商户会罚款 $50,000
NSFW_CHECK_ENABLED=1
NSFW_REJECT_THRESHOLD=0.8
NSFW_REVIEW_THRESHOLD=0.5
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# ====== 补图功能（可选）======
# SD Inpainting endpoint（RunPod 上部署的 SD Inpainting 服务地址）
# INPAINT_AUTODL_ENDPOINT=https://your-runpod-pod/api/inpaint

# ====== 文件存储（可选，后续接 Cloudflare R2）======
# R2_ACCOUNT_ID=your_r2_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret
# R2_BUCKET=live2d-layers
